APP_NAME=EverDigitech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.everdigitech.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=everdigitech
DB_USERNAME=root
DB_PASSWORD=

# --- Sanctum SPA cookie auth -------------------------------------------------------------------
# Origins (host:port, no scheme) whose requests get the session cookie + CSRF protection.
# admin panel = localhost:3003, client panel = localhost:3002.
SANCTUM_STATEFUL_DOMAINS=localhost:3003,localhost:3002
# Production:
# SANCTUM_STATEFUL_DOMAINS=admin.everdigitech.com,everdigitech.com

# Browser origins allowed to call the API with cookies (full origin, with scheme). Nothing else is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3002
# Production:
# CORS_ALLOWED_ORIGINS=https://admin.everdigitech.com,https://everdigitech.com

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=everdigitech_session
SESSION_SAME_SITE=lax
# Local: leave empty. Cookies are not port-specific, so localhost:3003, :3002 and :8000 share them.
SESSION_DOMAIN=null
# Production: one parent domain so admin.*, everdigitech.com and the API (api.everdigitech.com) share the cookie.
# SESSION_DOMAIN=.everdigitech.com
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Email (password reset and staff invites) -------------------------------------------------
# Local: "log" writes every email to storage/logs/laravel.log and sends nothing.
MAIL_MAILER=log
# Live, with the domain's own mail server (cPanel > Email Accounts > Connect Devices shows these values):
#   1. Create the mailbox noreply@everdigitech.com in cPanel.
#   2. Fill in the block below, set MAIL_MAILER=smtp, then run: php artisan config:clear
#   3. Send yourself a test: php artisan mail:test you@gmail.com
# MAIL_MAILER=smtp
# MAIL_HOST=mail.everdigitech.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps        # port 465 = SSL, needs smtps. For port 587 (STARTTLS) leave MAIL_SCHEME empty.
# MAIL_USERNAME=noreply@everdigitech.com
# MAIL_PASSWORD=
# MAIL_TIMEOUT=15
# Also set ADMIN_APP_URL below to the live admin address: the links in the emails point there.
MAIL_FROM_ADDRESS="noreply@everdigitech.com"
MAIL_FROM_NAME="${APP_NAME}"

# The support mailbox: ticket replies to clients are sent from it, and every new ticket and client reply is emailed to it.
# Forward it to the staff in cPanel (Forwarders). The SMTP login must be allowed to send as this address.
# The logo picture in emails. Used automatically when APP_URL is a public address (the file is public/images/everdigitech-email.png);
# set this to use another address. On localhost the emails show the name as text, because nobody else could open the picture.
# MAIL_LOGO_URL=https://api.everdigitech.com/images/everdigitech-email.png
# Tax on what clients buy (shown on the catalog and invoices). TAX_RATE is a percent. PRICES_INCLUDE_TAX=false means the
# prices entered in the catalog are before tax and tax is added; true means they already contain it.
TAX_LABEL=VAT
TAX_RATE=15
PRICES_INCLUDE_TAX=false
# Domain search and registration (Dynadot > Tools > API > Production key; allow this server's IP there).
DYNADOT_API_KEY=

SUPPORT_EMAIL=support@everdigitech.com
SUPPORT_NAME="EverDigitech Support"
# The support mailbox login (same mail server as above). When set, replies to clients are sent with it, so the mail
# server sees a real login for support@. Leave empty to send them with the MAIL_USERNAME login above.
SUPPORT_MAIL_USERNAME=
SUPPORT_MAIL_PASSWORD=

# --- First Super Admin (php artisan db:seed --class=SuperAdminSeeder) ---
# The seeder refuses to run if the password is shorter than 12 characters. Change it after first sign-in.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

ADMIN_APP_URL=http://localhost:3003
# Production: ADMIN_APP_URL=https://admin.everdigitech.com

# --- Client panel ---------------------------------------------------------------------------------
# Where the client panel runs. The "verify your email" and "new sign-in" emails link to it.
CLIENT_APP_URL=http://localhost:3002
# Production: CLIENT_APP_URL=https://everdigitech.com

# Cloudflare Turnstile (spam check on registration). Leave TURNSTILE_SECRET empty locally: the check is skipped.
# Cloudflare's always-pass test keys: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Real keys: Cloudflare dashboard > Turnstile > Add site. The site key goes in the client panel, the secret here.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Continue with Google (client panel). See config/services.php. Leave empty to turn it off.
GOOGLE_CLIENT_ID=
