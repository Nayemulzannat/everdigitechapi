# The LIVE .env for the server (api.everdigitech.com). Copy it to the server as `.env` and fill every CHANGE_ME.
# Never commit the real file. Then: php artisan key:generate (first time only), and see GO-LIVE.md section 2.

APP_NAME=EverDigitech
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.everdigitech.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database made in cPanel > MySQL Databases (the user needs ALL privileges on it). cPanel prefixes names: cpuser_dbname.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Website, admin panel and API share the parent domain, so the session cookie is sent between them.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_COOKIE=everdigitech_session
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.everdigitech.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=admin.everdigitech.com,everdigitech.com,www.everdigitech.com
CORS_ALLOWED_ORIGINS=https://admin.everdigitech.com,https://everdigitech.com,https://www.everdigitech.com
ADMIN_APP_URL=https://admin.everdigitech.com
CLIENT_APP_URL=https://everdigitech.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
# Emails are queued: a worker must run (GO-LIVE.md section 4) or nothing is sent.
QUEUE_CONNECTION=database

# Real mailbox (cPanel > Email Accounts). Without it no email is sent.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@everdigitech.com"
MAIL_FROM_NAME="${APP_NAME}"

SUPPORT_EMAIL=support@everdigitech.com
SUPPORT_NAME="EverDigitech Support"
SUPPORT_MAIL_USERNAME=
SUPPORT_MAIL_PASSWORD=

# Tax can also be changed later in the admin panel (Products > Tax); that wins over these.
TAX_LABEL=VAT
TAX_RATE=15
PRICES_INCLUDE_TAX=false

# Dynadot > Tools > API: allow THIS server's IP address, or domain search answers "not available".
DYNADOT_API_KEY=CHANGE_ME

# First-time seeding only (SuperAdminSeeder). Use a long password, then you may remove these lines.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME

# Cloudflare Turnstile (secret here, site key in the website) and Google sign-in.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
